# Vorlage. Die Datei .env wird vom Installations-Assistenten (/setup) erzeugt - normalerweise nicht von Hand anlegen.
# Diese Datei enthält Geheimnisse: Rechte 0600, nie ins Webroot (public/) legen, nie weitergeben.

APP_ENV=production
APP_NAME="Vertragsplattform"
APP_URL=https://vertraege.example.ch
# 64 Hex-Zeichen (32 Byte). Verschlüsselt MFA-Geheimnisse und leitet IP-Hashes ab. NIE ändern/verlieren:
# Bei Verlust sind alle MFA-Geheimnisse unbrauchbar (Neueinrichtung nötig). Erzeugen: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Optional: abweichender Speicherort ausserhalb des Webroots (Standard: <Projekt>/storage)
# STORAGE_PATH=/var/www/vhosts/example.ch/storage
MAX_UPLOAD_MB=20

# E-Mail (SMTP). Leer = kein Versand (Einladungen/Passwort-Reset funktionieren dann nicht!)
SMTP_HOST=
SMTP_PORT=465
# tls (implizit, Port 465) | starttls (Port 587) | none (nur lokale Tests)
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.ch
MAIL_FROM_NAME="Vertragsplattform"

# Signaturanbieter: sandbox (Standard, KEINE rechtsgültigen Signaturen) | skribble
SIGNATURE_PROVIDER=sandbox
# Nur bei skribble (Werte aus Ihrem Skribble-Vertrag/Entwicklerkonto; Demo-URL laut Skribble-Dokumentation):
SKRIBBLE_BASE_URL=
SKRIBBLE_USER=
SKRIBBLE_KEY=
# sandbox | live  (live erst nach bestandenem Test gegen die Demo-Umgebung, siehe docs/SIGNATURE_PROVIDER.md)
SKRIBBLE_MODE=sandbox

# Nur setzen, wenn ein Reverse-Proxy/Load-Balancer davor steht: Komma-getrennte IPs, deren X-Forwarded-* vertraut wird
TRUSTED_PROXIES=

# Sicherungen (bin/backup.php): Passphrase verschlüsselt das Archiv (der Assistent erzeugt eine zufällige). Getrennt vom Archiv aufbewahren!
BACKUP_PASSPHRASE=
BACKUP_KEEP=14
