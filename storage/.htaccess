# Sicherheitsnetz: Falls der Dokumentenstamm versehentlich auf den Projektordner statt auf public/ zeigt,
# wird NICHTS ausgeliefert (weder Code noch .env). Richtig ist: Dokumentenstamm = <Projektordner>/public
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
